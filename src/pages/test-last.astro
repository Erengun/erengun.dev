---
// Test page for the last portal (tile 5). Query: ?t=<sceneT, may be < 0> | ?vp=<viewports> , ?open=0..1,
// ?px=&py= (parallax -1..1), ?webgl (force WebGL2), ?ui (slider)
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>test: last portal</title>
    <style>
      html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
      #app, canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }
      .ui { position: fixed; left: 12px; right: 12px; bottom: 12px; display: flex; gap: 10px; align-items: center;
        font: 12px/1 monospace; color: #fff; background: #0008; padding: 8px; }
      .ui input { flex: 1; }
      .ui[hidden] { display: none; }
    </style>
  </head>
  <body>
    <div id="app"></div>
    <div class="ui" hidden><span>vp</span><input type="range" min="4.6" max="18.1" step="0.01" /><b>6.2</b></div>
    <script>
      import { WebGPURenderer, PerspectiveCamera, RenderTarget, HalfFloatType, MeshBasicNodeMaterial, QuadMesh } from 'three/webgpu';
      import { texture, screenUV } from 'three/tsl';
      import { createLastPortal } from '../scene/portals/last.wip';
      import { PORTAL_H, PORTAL_W } from '../scene/types';
      import { SCENE_START, SCENE_VP } from '../lib/timeline';

      const q = new URLSearchParams(location.search);
      const renderer = new WebGPURenderer({ antialias: false, forceWebGL: q.has('webgl') });
      await renderer.init();
      document.getElementById('app')!.appendChild(renderer.domElement);
      const quality = (renderer.backend as any).isWebGLBackend ? 'medium' : 'high';
      const isPhone = innerWidth < 768 || innerWidth / innerHeight < 4 / 3;
      const portal = createLastPortal({ renderer, isPhone, quality: (q.get('quality') as any) ?? quality });

      let vp = q.has('vp') ? +q.get('vp')! : SCENE_START + (q.has('t') ? +q.get('t')! : 0) * SCENE_VP;
      const open = q.has('open') ? +q.get('open')! : 1;
      const ui = document.querySelector('.ui') as HTMLElement;
      const slider = ui.querySelector('input') as HTMLInputElement;
      const label = ui.querySelector('b')!;
      if (q.has('ui')) {
        ui.hidden = false;
        slider.value = String(vp);
        slider.oninput = () => { vp = +slider.value; };
      }

      const cam = new PerspectiveCamera(110, 1, 0.01, 1000);
      const rt = new RenderTarget(1, 1, { type: HalfFloatType, depthBuffer: true });
      const blitMat = new MeshBasicNodeMaterial();
      blitMat.colorNode = texture(rt.texture, screenUV);
      const blit = new QuadMesh(blitMat);
      const pointer = { x: 0, y: 0, inside: false, down: false };
      const parallax = { x: +(q.get('px') ?? 0), y: +(q.get('py') ?? 0) };

      function resize() {
        renderer.setPixelRatio(Math.min(devicePixelRatio, 1.6));
        renderer.setSize(innerWidth, innerHeight, false);
        rt.setSize(renderer.domElement.width, renderer.domElement.height);
        cam.aspect = innerWidth / innerHeight;
        cam.updateProjectionMatrix();
      }
      resize();
      addEventListener('resize', resize);
      addEventListener('pointermove', (e) => {
        pointer.x = (e.clientX / innerWidth) * 2 - 1; pointer.y = 1 - (e.clientY / innerHeight) * 2; pointer.inside = true;
        if (!q.has('px')) { parallax.x = pointer.x; parallax.y = pointer.y; }
      });

      await portal.ready;
      (window as any).__lastReady = true;
      (window as any).__setVp = (v: number) => { vp = v; };

      let last = performance.now();
      const t0 = last;
      let frames = 0, fpsT = 0;
      renderer.setAnimationLoop(() => {
        const now = performance.now();
        const dt = Math.min(0.05, (now - last) / 1000);
        last = now;
        // inner camera = main camera in the portal plane frame, fully open (same math as app.ts)
        const tt = Math.tan((cam.fov * Math.PI) / 360);
        const cover = Math.min(PORTAL_H / (2 * tt), PORTAL_W / (2 * tt * cam.aspect));
        const ease = open * open * (3 - 2 * open);
        cam.position.set(0, 0, 1 + (cover * 0.8 - 1) * ease);
        cam.updateMatrixWorld(true);
        portal.update({
          dt, time: (now - t0) / 1000, openness: open, focus: 1, camera: cam, pointer, parallax, vp,
          sceneT: Math.min(1, Math.max(0, (vp - SCENE_START) / SCENE_VP)), isPhone, gateOpen: true, slide: 0, inside: false,
        });
        portal.render!(renderer as any, cam, rt);
        renderer.setRenderTarget(null);
        blit.render(renderer);
        frames++; fpsT += dt;
        if (fpsT > 1) { (window as any).__fps = frames / fpsT; frames = 0; fpsT = 0; }
        label.textContent = vp.toFixed(2);
      });
    </script>
  </body>
</html>
