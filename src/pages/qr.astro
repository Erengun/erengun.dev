---
// A link as a small Istanbul: every dark module of its QR code is a rooftop, and from above the rooftops scan.
// Standalone and light: none of the journey's renderer or assets load here.
import { SITE } from '../lib/content';
const title = `QR Istanbul — ${SITE.name}`;
const description = 'Turn any link into a small Istanbul. Tap it and, from straight above, the rooftops are a QR code your phone can scan.';
const url = 'https://erengun.dev/qr/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3ead8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://erengun.dev/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="qr" data-qr data-state="city">
      <header class="qr__bar">
        <a class="qr__logo" href="/">{SITE.name}</a>
        <span class="qr__right">
          <span class="qr__tag">&gt; qr istanbul</span>
          <button class="qr__sound" type="button" data-qr-sky aria-pressed="false" aria-label="Day. Switch to night">
            <svg class="off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          </button>
          <div class="qr__music" data-qr-music data-open="false" data-playing="false">
            <div class="qr__music-box">
              <div class="qr__music-bar">
                <span class="qr__music-now"><span class="qr__eq" aria-hidden="true"><i></i><i></i><i></i></span><span data-qr-now></span></span>
                <button class="qr__sound" type="button" data-qr-sound aria-pressed="true" aria-expanded="false" aria-controls="qr-tracks" aria-label="Music">
            <svg class="on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Z" /><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" /></svg>
            <svg class="off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Z" /><path d="m16 9 5 6M21 9l-5 6" /></svg>
                </button>
              </div>
              <ul class="qr__music-list" id="qr-tracks" data-qr-tracks aria-label="Music to play"></ul>
            </div>
          </div>
        </span>
      </header>
      <div class="qr__sky" aria-hidden="true"></div>
      <div class="qr__player" data-qr-player hidden><div id="qr-yt"></div></div>
      <canvas class="qr__canvas" aria-label="A small Istanbul whose rooftops form a QR code for the link below"></canvas>
      <div class="qr__panel" data-qr-panel>
        <button class="qr__toggle" type="button" data-qr-toggle aria-pressed="false">Tap the city to see the code</button>
        <div class="qr__row">
          <label class="qr__field">
            <span class="qr__sr">Link to turn into a city</span>
            <input data-qr-input type="url" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="300" placeholder="https://erengun.dev" />
          </label>
          <button class="qr__share" type="button" data-qr-share aria-label="Share this city">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3m0 0L7.5 7.5M12 3l4.5 4.5M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" /></svg>
          </button>
        </div>
        <div class="qr__modes" role="group" aria-label="Season">
          <button type="button" data-qr-season="spring" aria-pressed="false">Spring</button>
          <button type="button" data-qr-season="summer" aria-pressed="false">Summer</button>
          <button type="button" data-qr-season="autumn" aria-pressed="false">Autumn</button>
          <button type="button" data-qr-season="winter" aria-pressed="false">Winter</button>
        </div>
        <p class="qr__note" data-qr-note role="status" aria-live="polite"></p>
        <p class="qr__credit">Map data © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors</p>
      </div>
    </main>
    <script>
      import '../scripts/qr-city.ts';
      import '../scripts/qr-music.ts';
    </script>
  </body>
</html>

<style is:global>
  :root { --ink: #1b1712; --soft: rgb(27 23 18 / .58); --page: #f3ead8; --accent: #ff5a1f; --line: rgb(27 23 18 / .16); --glass: rgb(255 255 255 / .6); --on: #fff; --tag: rgb(255 255 255 / .82); --card: rgb(255 252 246 / .94); --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace; --sans: "Space Grotesk", system-ui, sans-serif; }
  :root[data-sky="night"] { --ink: #f4eee1; --soft: rgb(244 238 225 / .62); --line: rgb(255 255 255 / .2); --glass: rgb(255 255 255 / .08); --on: rgb(255 255 255 / .2); --tag: rgb(12 18 38 / .72); --card: rgb(22 28 54 / .94); }
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body { background: var(--page); color: var(--ink); font-family: var(--sans); overflow: hidden; -webkit-font-smoothing: antialiased; }
  .qr { position: fixed; inset: 0; }
  /* the night sky sits behind the city only: the code is always read on the pale page */
  .qr__sky { position: absolute; inset: 0; opacity: 0; transition: opacity .45s ease; pointer-events: none;
    background:
      radial-gradient(1.5px 1.5px at 12% 22%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 27% 9%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 44% 17%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 61% 7%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 70% 27%, #fff 50%, transparent 51%), radial-gradient(1.5px 1.5px at 92% 38%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 6% 48%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 36% 31%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 55% 36%, #fff 50%, transparent 51%), radial-gradient(1.5px 1.5px at 19% 62%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 88% 61%, #fff 50%, transparent 51%),
      linear-gradient(#0a1024, #17203f 62%, #2a2b4a); }
  :root[data-sky="night"] .qr__sky { opacity: 1; }
  .qr__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .qr[data-state="flat"] .qr__canvas { inset: auto; left: 50%; top: 42%; transform: translate(-50%, -50%); cursor: default; }
  .qr__bar { position: absolute; z-index: 4; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; padding: calc(env(safe-area-inset-top, 0px) + 1.1rem) 1.25rem 0; pointer-events: none; }
  .qr__logo { pointer-events: auto; color: var(--ink); text-decoration: none; font-weight: 700; letter-spacing: -.01em; transition: color .45s; }
  .qr__tag, .qr__toggle, .qr__note, .qr__modes button { font-family: var(--mono); font-size: .6875rem; text-transform: uppercase; letter-spacing: .08em; }
  .qr__tag { color: var(--soft); transition: color .45s; }
  .qr__panel { position: absolute; z-index: 2; left: 50%; bottom: 0; transform: translateX(-50%); width: min(100% - 2rem, 34rem); padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 1rem); display: grid; gap: .6rem; justify-items: center; }
  .qr__toggle { appearance: none; border: 1px solid var(--line); background: var(--glass); color: var(--soft); border-radius: 999px; padding: .55rem 1rem; cursor: pointer; transition: background-color .3s, color .3s, border-color .3s; }
  .qr__toggle:hover { color: var(--ink); }
  .qr__row { display: flex; gap: .5rem; width: 100%; }
  .qr__field { flex: 1; min-width: 0; }
  .qr__field input { width: 100%; height: 3rem; border-radius: .8rem; border: 1px solid var(--line); background: var(--glass); color: var(--ink); font: 400 1rem var(--mono); padding: 0 1rem; outline: none; transition: border-color .3s, background-color .3s, color .3s; }
  .qr__field input::placeholder { color: var(--soft); }
  .qr__field input:focus-visible { border-color: var(--accent); }
  .qr__share { flex: none; width: 3rem; height: 3rem; border-radius: .8rem; border: 0; background: var(--accent); color: #140700; display: grid; place-items: center; cursor: pointer; transition: filter .2s; }
  .qr__share:hover { filter: brightness(1.08); }
  .qr__modes { display: grid; grid-template-columns: repeat(4, 1fr); gap: .25rem; width: 100%; padding: .25rem; border-radius: .8rem; border: 1px solid var(--line); background: var(--glass); transition: border-color .3s, background-color .3s; }
  .qr__modes[hidden] { display: none; }
  .qr__modes button { appearance: none; border: 0; background: transparent; color: var(--soft); height: 2.4rem; border-radius: .6rem; display: flex; gap: .5rem; align-items: center; justify-content: center; cursor: pointer; transition: background-color .3s, color .3s; }
  .qr__modes button[aria-pressed="true"] { background: var(--on); color: var(--ink); box-shadow: 0 1px 2px rgb(0 0 0 / .12); }
  .qr__toggle:focus-visible, .qr__share:focus-visible, .qr__logo:focus-visible, .qr__modes button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .qr__note { min-height: 1.1em; margin: 0; color: var(--soft); text-align: center; overflow-wrap: anywhere; text-transform: none; letter-spacing: 0; }
  .qr__note:empty { display: none; }
  .qr__names { position: absolute; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; transition: opacity .25s; }
  .qr__names span { position: absolute; left: 0; top: 0; white-space: nowrap; font: 500 .625rem var(--mono); letter-spacing: .04em; color: var(--ink); background: var(--tag); padding: .12rem .4rem; border-radius: 999px; will-change: transform; transition: opacity .2s; box-shadow: 0 1px 3px rgb(0 0 0 / .12); }
  .qr__names span::after { content: ''; position: absolute; left: 50%; top: 100%; width: 1px; height: .5rem; background: var(--soft); }
  .qr__credit { margin: 0; font: 400 .625rem var(--mono); color: var(--soft); }
  .qr__credit a { color: inherit; }
  .qr__right { display: flex; align-items: center; gap: .5rem; }
  .qr__right .qr__tag { margin-right: .25rem; }
  @media (max-width: 420px) { .qr__right .qr__tag { display: none; } }
  .qr__sound { pointer-events: auto; appearance: none; width: 2.25rem; height: 2.25rem; border-radius: 999px; border: 1px solid var(--line); background: var(--glass); color: var(--ink); display: grid; place-items: center; cursor: pointer; transition: background-color .3s, color .3s, border-color .3s; }
  .qr__sound .off, .qr__sound[aria-pressed="false"] .on { display: none; }
  .qr__sound[aria-pressed="false"] .off { display: block; }
  .qr__sound[data-qr-sound][aria-pressed="false"] { color: var(--soft); }
  .qr__sound[hidden] { display: none; }
  .qr__sound:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  /* YouTube's player: only heard, never seen */
  .qr__player { position: absolute; left: 0; top: 0; width: 200px; height: 113px; opacity: 0; pointer-events: none; z-index: -1; }
  .qr__player[hidden] { display: none; }
  @media (max-width: 640px) { .qr__names span { font-size: .5625rem; } }
  /* the music: a round button that opens into a small player, the list of recordings under it */
  .qr__music { position: relative; width: 2.25rem; height: 2.25rem; pointer-events: auto; }
  .qr__music-box { position: absolute; right: 0; top: 0; width: 2.25rem; border-radius: 1.125rem; border: 1px solid var(--line); background: var(--glass); overflow: hidden; transition: width .42s cubic-bezier(.22, 1, .36, 1), border-radius .42s, background-color .3s, box-shadow .3s, border-color .3s; }
  .qr__music-bar { display: flex; align-items: center; justify-content: flex-end; height: calc(2.25rem - 2px); }
  .qr__music .qr__sound { flex: none; border: 0; background: transparent; width: calc(2.25rem - 2px); height: calc(2.25rem - 2px); }
  .qr__music-now { flex: 1; min-width: 0; display: flex; align-items: center; gap: .55rem; padding-left: .9rem; font: 500 .8125rem var(--sans); color: var(--ink); white-space: nowrap; opacity: 0; transition: opacity .2s; }
  .qr__music-now [data-qr-now] { overflow: hidden; text-overflow: ellipsis; }
  .qr__music-list { list-style: none; margin: 0; padding: 0 .35rem; max-height: 0; opacity: 0; transition: max-height .42s cubic-bezier(.22, 1, .36, 1), opacity .25s, padding .42s; }
  .qr__music-list button { appearance: none; width: 100%; border: 0; background: transparent; color: var(--soft); display: flex; align-items: center; gap: .6rem; padding: .6rem .55rem; border-radius: .6rem; cursor: pointer; text-align: left; font: 400 .8125rem var(--sans); transition: background-color .2s, color .2s; }
  .qr__music-list button:hover { background: var(--glass); color: var(--ink); }
  .qr__music-list button[aria-current="true"] { color: var(--ink); font-weight: 500; }
  .qr__music-list .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .qr__music-list .d { font: 400 .6875rem var(--mono); }
  .qr__music-list button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .qr__music[data-open="true"] .qr__music-box { width: min(21rem, 100vw - 2.5rem); border-radius: 1rem; background: var(--card); box-shadow: 0 8px 28px rgb(0 0 0 / .16); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); z-index: 5; }
  .qr__music[data-open="true"] .qr__music-now { opacity: 1; transition-delay: .15s; }
  .qr__music[data-open="true"] .qr__music-list { max-height: 14rem; opacity: 1; padding: .15rem .35rem .4rem; transition-delay: .08s; }
  /* three bars that move while it plays */
  .qr__eq { flex: none; display: inline-flex; align-items: flex-end; gap: 2px; width: 12px; height: 12px; }
  .qr__eq i { flex: 1; height: 30%; background: var(--accent); border-radius: 1px; }
  .qr__music-list .qr__eq { visibility: hidden; }
  .qr__music-list button[aria-current="true"] .qr__eq { visibility: visible; }
  .qr__music[data-playing="true"] .qr__eq i { animation: qr-eq .9s ease-in-out infinite alternate; }
  .qr__music[data-playing="true"] .qr__eq i:nth-child(2) { animation-delay: -.3s; }
  .qr__music[data-playing="true"] .qr__eq i:nth-child(3) { animation-delay: -.6s; }
  @keyframes qr-eq { from { height: 20%; } to { height: 100%; } }
  @media (prefers-reduced-motion: reduce) { .qr__music-box, .qr__music-list, .qr__music-now { transition: none; } .qr__eq i { animation: none !important; height: 60%; } }
  .qr__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
