---
import '../styles/global.css';
import { SITE, SOCIALS, MENU, PROJECTS, LAST } from '../lib/content';
import { TOTAL_VP, STAGES } from '../lib/timeline';
import { getPosts } from '../lib/blog';
const posts = await getPosts();
const STAGE_COUNT = STAGES.length;
const linkLabel = (u: string) => (u.includes('apps.apple.com') ? 'App Store' : u.replace(/^https:\/\/(www\.)?/, ''));
const CHAPTERS = [
  { id: 'intro', n: '00', label: 'Intro', href: '/' },
  { id: 'about', n: '01', label: 'About', href: '/#about' },
  { id: 'who', n: '02', label: 'Who I work with', href: '/#who' },
  { id: 'work', n: '03', label: 'Work', href: '/#work' },
  { id: 'contact', n: '04', label: 'Contact', href: '/#contact' },
];
const FEATURED = [
  { id: 'oge', label: 'Latest · Öge', href: '/#work' },
  { id: 'cached-network-image-ce', label: 'Most used · CNI CE', href: '/#work-3' },
];
const pad = (n: number) => String(n).padStart(2, '0');
const URL_BASE = 'https://erengun.dev/';
const TITLE = `${SITE.name} — Software Developer | AI Engineering`;
const DESC = 'Eren Gün is a software developer from Istanbul working on AI engineering, developer tools and fast Flutter apps: Öge, Ferman, Cached Network Image CE, Elek and Subara.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': URL_BASE + '#website', url: URL_BASE, name: SITE.name, inLanguage: 'en' },
    {
      '@type': 'Person', '@id': URL_BASE + '#person', name: SITE.name, url: URL_BASE, jobTitle: 'Software Developer | AI Engineering',
      image: URL_BASE + 'og.jpg', email: 'mailto:' + SITE.email,
      address: { '@type': 'PostalAddress', addressLocality: 'Istanbul', addressCountry: 'TR' },
      knowsAbout: ['AI engineering', 'AI coding agents', 'Flutter', 'Dart', 'Rust', 'Go', 'Developer tools', 'Mobile apps', 'Code push / live updates'],
      sameAs: SOCIALS.filter((s) => s.href.startsWith('http')).map((s) => s.href),
    },
    ...PROJECTS.map((p) => ({
      '@type': p.id === 'subara' ? 'SoftwareApplication' : 'SoftwareSourceCode',
      name: p.title, description: p.info, author: { '@id': URL_BASE + '#person' },
      ...(p.url ? { url: p.url } : {}),
      ...(p.id === 'subara' ? { applicationCategory: 'FinanceApplication', operatingSystem: 'iOS' } : {}),
    })),
  ],
};
---
<!doctype html>
<html lang="en" style={`--scroll-viewports:${TOTAL_VP}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#08080a" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="description" content={DESC} />
    <meta name="author" content={SITE.name} />
    <link rel="canonical" href={URL_BASE} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={URL_BASE} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESC} />
    <meta property="og:image" content={URL_BASE + 'og.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eren Gün skiing, in the site's VHS-styled 3D intro scene" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESC} />
    <meta name="twitter:image" content={URL_BASE + 'og.jpg'} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Eren Gün — Blog" href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%23000'/%3E%3Ccircle cx='8' cy='8' r='3' fill='%2311ff00'/%3E%3C/svg%3E" />
    <title>{TITLE}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="is--loading">
    <a class="sr-only" href="#about">Skip to content</a>
    <main id="content" class="sr-only">
      <h1>{SITE.name} — Software Developer | AI Engineering</h1>
      <p>{SITE.tagline}</p>
      <section aria-labelledby="seo-about">
        <h2 id="seo-about">About</h2>
        {LAST.map((l) => (<><h3>{l.h}</h3><p>{l.b1}</p>{l.b2 && <p>{l.b2}</p>}</>))}
      </section>
      <section aria-labelledby="seo-work">
        <h2 id="seo-work">Selected work</h2>
        <ol>
          {PROJECTS.map((p) => (
            <li><article><h3>{p.url ? <a href={p.url}>{p.title}</a> : p.title}</h3><p>{p.info}</p><p>Role: {p.roles.join(', ')}</p></article></li>
          ))}
        </ol>
      </section>
      <section aria-labelledby="seo-blog">
        <h2 id="seo-blog"><a href="/blog/">Blog</a></h2>
        <ul>{posts.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}</ul>
      </section>
      <section aria-labelledby="seo-contact">
        <h2 id="seo-contact">Contact</h2>
        <p>Let's talk about your next project: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <ul>{SOCIALS.map((s) => <li><a href={s.href} rel="me">{s.label}</a></li>)}</ul>
      </section>
    </main>

    <div class="preloader" data-preloader role="status" aria-live="polite">
      <div class="pl-top container-b">
        <span class="pl-name">{SITE.name}</span>
        <span class="mono">Loading the journey</span>
        <span class="mono hide-phone">{STAGE_COUNT} scenes · {PROJECTS.length} projects</span>
        <span class="mono pl-right hide-phone">Istanbul, TR</span>
      </div>
      <div class="pl-line container-b"><i data-preloader-bar></i></div>
      <div class="pl-bottom container-b">
        <p class="pl-count"><span data-preloader-count>0</span><small>%<br />loaded</small></p>
        <p class="mono pl-note">Best with a real GPU</p>
      </div>
      <div class="motion-gate" role="dialog" aria-modal="true" aria-label="Motion sensors">
        <p class="mono">Optional</p>
        <p class="mg-h">Tilt your phone to look around?</p>
        <p class="mg-b">The scenes can follow your device's motion and orientation sensors. Nothing is stored or sent anywhere.</p>
        <div class="btns"><button class="allow" data-motion-allow>Allow motion</button><button class="decline" data-motion-decline>No thanks</button></div>
      </div>
    </div>

    <div class="stage" data-stage data-scene="home">
      <div class="page-scroll" data-page-scroll tabindex="-1">
        <div class="perspective-root">
          <div class="scene-tilt">
            <div id="app"></div>
          </div>
        </div>

        <section class="ov intro" data-intro>
          <div class="container-b intro__grid">
            <p class="intro__name" aria-hidden="true"><span data-reveal>Eren</span><span data-reveal>Gün</span></p>
            <div class="intro__side" data-reveal>
              <p class="intro__para">{SITE.tagline}</p>
              <p class="mono intro__meta"><span>Field notes, {SITE.year}</span><span>Scroll ↓</span></p>
            </div>
          </div>
        </section>

        <section class="ov project" data-project>
          {PROJECTS.map((p, i) => (
            <div class="project-panel" data-project-panel={i}>
              <div class="container-b pp-grid">
                <div class="pp-col-title">
                  <p class="mono pp-counter">{pad(i + 1)} / {pad(PROJECTS.length)} · slide <span data-project-slide-number>01</span> / {pad(p.slides)}</p>
                  <h2 class:list={["pp-title", { "is-long": p.title.length > 10 }]}>{p.title}</h2>
                </div>
                <div class="pp-col pp-col-info">
                  <p class="mono pp-label">What</p>
                  <p class="pp-text">{p.info}</p>
                </div>
                <div class="pp-col pp-col-role">
                  <p class="mono pp-label">Role</p>
                  <p class="pp-text">{p.roles.join(', ')}</p>
                  {p.url ? <a class="pp-link" href={p.url} target="_blank" rel="noopener">{linkLabel(p.url)} ↗</a> : <p class="pp-text pp-dim">Private repository</p>}
                  <div class="pp-thumbs">
                    {Array.from({ length: p.slides }).map((_, s) => (
                      <button data-thumb={s} aria-label={`${p.title}, slide ${s + 1}`} disabled><img alt="" data-thumb-img={`${p.id}:${s}`} /></button>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </section>

        <section class="ov last" data-last>
          <div class="last-backdrop" data-last-backdrop-fade></div>
          {LAST.map((s, i) => (
            <div class="last-stage" data-last-stage={i} id={i === 0 ? 'about' : undefined}>
              <div class="last-block" data-last-scroll={i}>
                <p class="mono last-label">{pad(i + 1)} — {s.h.replace(/^about me$/, "about")}</p>
                <div class="last-text">
                  <p class="b1">{s.b1}</p>
                  {s.b2 && <p class="b2">{s.b2}</p>}
                </div>
                <a class="mono last-more" href="/#work">See the work →</a>
              </div>
            </div>
          ))}
          <div class="last-stage" data-last-stage="2" id="contact">
            <div class="talk-wrap" data-last-parallax>
              <div class="container-b talk-grid">
                <p class="mono talk-label" data-talk-reveal>04 — Contact</p>
                <a class="talk" href={`mailto:${SITE.email}`} data-talk-reveal>
                  <span class="talk__h">Let's talk about your next project.</span>
                  <span class="talk__mail">{SITE.email} <span aria-hidden="true">↗</span></span>
                </a>
                <div class="talk-side" data-talk-reveal>
                  <p class="talk__sub">Drop me an email and tell me what you're building.</p>
                  <ul class="mono socials">
                    {SOCIALS.map((s) => <li><a href={s.href}>{s.label}{s.href.startsWith('http') ? ' ↗' : ''}</a></li>)}
                  </ul>
                </div>
              </div>
            </div>
            <div class="last-bottom">
              <button class="mono scroll-back" data-scroll-back data-talk-reveal>↑ Back to the work</button>
              <div class="container-b" data-talk-reveal>
                <div class="footer-row mono">
                  <a href="/privacy/">Privacy</a>
                  <a href="/blog/">Blog</a>
                  <span>© {SITE.year} {SITE.name}</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <nav class="ov rail" data-work aria-label="Chapters">
          <ol class="mono rail__list">
            {CHAPTERS.map((c) => (
              <li data-chapter={c.id}>
                <a href={c.href}><i></i>{c.n} {c.label}</a>
                {c.id === 'work' && (
                  <ol class="rail__projects work__list">
                    {PROJECTS.map((p, i) => <li><button data-work-item={i}><i></i>{pad(i + 1)} {p.short ?? p.title}</button></li>)}
                  </ol>
                )}
              </li>
            ))}
          </ol>
        </nav>

        <div class="scroll-length" data-scroll-length></div>
      </div>
    </div>

    <div class="menu-backdrop" data-menu-backdrop></div>

    <header class="header" data-header>
      <div class="container-b header__grid">
        <a class="header__logo" href="/">{SITE.name}</a>
        <p class="mono header__col hide-phone" data-hdr-a>Software developer<br />AI engineering</p>
        <p class="mono header__col hide-phone" data-hdr-b>Istanbul, TR<br />41.0082° N 28.9784° E</p>
        <div class="header__right mono">
          <a class="header__talk" href={`mailto:${SITE.email}`} data-talk>Write me</a>
          <nav class="menu" data-menu>
            <button class="menu-trigger" data-menu-trigger aria-expanded="false" aria-controls="menu-list">
              <span class="when-closed">Index</span><span class="when-closed bars" aria-hidden="true"></span>
              <span class="when-open">Close ×</span>
            </button>
            <div class="menu-sheet" id="menu-list" data-menu-list>
              <ul class="menu-items">
                {MENU.filter((m) => !m.href.startsWith('http')).map((m) => (
                  <li><a class="item" href={m.href} aria-current={m.href === '/' ? 'page' : undefined}><span class="mono">{m.n}</span><span class="item__t">{m.label}</span><span class="mono">{m.note}</span></a></li>
                ))}
              </ul>
              <div class="menu-feature">
                {FEATURED.map((f) => (
                  <a href={f.href}><span class="menu-feature__img"><img alt="" data-thumb-img={`${f.id}:0`} /></span><span class="mono">{f.label}</span></a>
                ))}
              </div>
              <div class="menu-foot mono">
                <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
                <span><a href="https://github.com/Erengun">GitHub ↗</a><a href="https://www.linkedin.com/in/erengun/">LinkedIn ↗</a></span>
              </div>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <div class="page-fade" data-page-fade></div>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
