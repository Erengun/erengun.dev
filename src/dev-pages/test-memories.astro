---
// Test page for the memory stages (src/scene/memories). Query:
//   ?stage=stage|teams   ?t=0.5 freeze local progress (else loops)   ?webgl force WebGL2
//   ?post  run through fish-eye + camcorder chain   ?px=1&py=-1 force parallax   ?time=3 freeze clock
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>test: memories</title>
    <link rel="icon" href="data:," />
    <style>
      html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
      #c { position: fixed; inset: 0; }
      #hud { position: fixed; left: 8px; bottom: 8px; color: #ccc; font: 11px/1.3 monospace; z-index: 2; white-space: pre; }
      #cap { position: fixed; left: 40px; bottom: 60px; color: #fff; font: 14px/1.4 Helvetica, Arial, sans-serif; z-index: 2; max-width: 420px; text-shadow: 0 1px 3px #000; }
      #cap b { display: block; font-size: 28px; }
      #cap i { font-style: normal; font-family: monospace; font-size: 11px; text-transform: uppercase; opacity: .7; }
    </style>
  </head>
  <body>
    <div id="c"></div>
    <div id="cap"></div>
    <div id="hud"></div>
    <script>
      import { WebGPURenderer, PerspectiveCamera, RenderPipeline, Vector2 } from 'three/webgpu';
      import { pass, uniform, screenUV, vec4 } from 'three/tsl';
      import { fishEye, overscanScale } from '../scene/post/fisheye';
      import { createCamcorder } from '../scene/post/camcorder';
      import { createMemoryStages, MEMORY_COPY } from '../scene/memories/index';

      const q = new URLSearchParams(location.search);
      const id = q.get('stage') ?? 'stage';
      const freezeT = q.has('t') ? Number(q.get('t')) : null;
      const freezeTime = q.has('time') ? Number(q.get('time')) : null;
      const el = document.getElementById('c')!;
      const hud = document.getElementById('hud')!;
      const renderer = new WebGPURenderer({ antialias: false, forceWebGL: q.has('webgl') });
      await renderer.init();
      el.appendChild(renderer.domElement);
      const backend = (renderer.backend as any).isWebGLBackend ? 'webgl2' : 'webgpu';
      const isPhone = innerWidth < 700;

      const stages = createMemoryStages({ renderer, isPhone, quality: 'high' });
      const stage = stages.find((s) => s.id === id)!;
      const copy = MEMORY_COPY.find((c) => c.id === id)!;
      if (!q.has('nocap')) document.getElementById('cap')!.innerHTML = `<i>${copy.kicker}</i><b>${copy.title}</b>${copy.body}`;

      const usePost = q.has('post');
      const passCamera = new PerspectiveCamera();
      const uFish = uniform(0.1), uOverscan = uniform(1);
      let pipeline: RenderPipeline | null = null;
      let cam: ReturnType<typeof createCamcorder> | null = null;
      if (usePost) {
        const scenePass = pass(stage.scene, passCamera);
        const src = scenePass.getTextureNode('output');
        const uvFish = fishEye(screenUV, uFish, uOverscan);
        const sampled = src.sample(uvFish);
        pipeline = new RenderPipeline(renderer);
        cam = createCamcorder({ renderer, source: sampled, sourceTexture: src as any, uvFish, uFish, uOverscan });
        pipeline.outputNode = q.has('nocam') ? vec4(sampled.rgb, 1) : cam.output;
      }
      const size = new Vector2();
      function resize() {
        renderer.setPixelRatio(Math.min(devicePixelRatio, 1.6));
        renderer.setSize(innerWidth, innerHeight, false);
        stage.camera.aspect = innerWidth / innerHeight;
        stage.camera.updateProjectionMatrix();
        renderer.getDrawingBufferSize(size);
        cam?.setSize(size.x, size.y);
      }
      resize();
      addEventListener('resize', resize);

      const pointer = { x: 0, y: 0, inside: false, down: false };
      addEventListener('pointermove', (e) => {
        pointer.x = (e.clientX / innerWidth) * 2 - 1;
        pointer.y = 1 - (e.clientY / innerHeight) * 2;
        pointer.inside = !q.has('nohover');
      });
      const par = { x: 0, y: 0 };
      const t0 = performance.now();
      await stage.ready;
      const loadMs = performance.now() - t0;
      let last = performance.now(), n = 0;
      const frames: number[] = [];
      const postState = { isHome: false, isPhone, inside: true, idx: 0, sceneT: 0, lastOpen: 0 };
      renderer.setAnimationLoop(() => {
        const now = performance.now();
        const dt = Math.min((now - last) / 1000, 0.05);
        frames.push(now - last); if (frames.length > 120) frames.shift();
        last = now;
        const time = freezeTime ?? (now - t0) / 1000;
        const t = freezeT ?? ((time / 40) % 1.1) - 0.05;
        const tx = q.has('px') ? Number(q.get('px')) : pointer.x, ty = q.has('py') ? Number(q.get('py')) : pointer.y;
        par.x += (tx - par.x) * (1 - Math.exp(-3 * dt));
        par.y += (ty - par.y) * (1 - Math.exp(-3 * dt));
        if (q.has('px')) { par.x = tx; par.y = ty; }
        stage.update({
          dt, time, t, enter: 1, exit: 0, vp: 0, pointer, parallax: par, aspect: innerWidth / innerHeight,
          isPhone, quality: 'high', slide: 0, gateOpen: true,
        });
        if (pipeline) {
          const s = (uOverscan.value = overscanScale(stage.camera.aspect, uFish.value));
          passCamera.position.copy(stage.camera.position);
          passCamera.quaternion.copy(stage.camera.quaternion);
          passCamera.near = stage.camera.near; passCamera.far = stage.camera.far;
          passCamera.fov = (2 * Math.atan(Math.tan((stage.camera.fov * Math.PI) / 360) * s) * 180) / Math.PI;
          passCamera.aspect = stage.camera.aspect / s;
          passCamera.updateProjectionMatrix();
          passCamera.updateMatrixWorld();
          cam?.update(dt, time, postState);
          pipeline.render();
        } else {
          renderer.render(stage.scene, stage.camera);
        }
        if (++n % 30 === 0) {
          const s = [...frames].sort((a, b) => a - b);
          const cp = stage.camera.position; hud.textContent = JSON.stringify({ backend, id, t: +t.toFixed(3), loadMs: Math.round(loadMs), p50: +s[s.length >> 1].toFixed(1), cam: [cp.x, cp.y, cp.z].map((v) => +v.toFixed(2)) });
        }
        if (n === 40) document.body.dataset.ready = '1';
      });
    </script>
  </body>
</html>
